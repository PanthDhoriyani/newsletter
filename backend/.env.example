# News APIs
NEWSDATA_API_KEY=your_newsdata_key_here
CURRENTS_API_KEY=your_currents_key_here
GNEWS_API_KEY=your_gnews_key_here

# LLM APIs
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# Database (sqlite+aiosqlite:///./newspaper.db or postgresql+asyncpg://user:pass@localhost:5432/newspaper_db)
DATABASE_URL=sqlite+aiosqlite:///./newspaper.db

# App Settings
NEWSPAPER_GENERATION_TIME=08:00
TIMEZONE=Asia/Kolkata
MAX_GENERATION_RETRIES=3
ENVIRONMENT=development
SECRET_KEY=digital_newspaper_secret_key_super_secure_2026_x99
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Quota Guards
GEMINI_DAILY_LIMIT=1000
GROQ_DAILY_TOKEN_LIMIT=200000
